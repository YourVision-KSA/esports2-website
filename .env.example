# Copy to .env and fill in. NEVER commit .env.
# Local development defaults are shown; production values come from Secret Manager.

DJANGO_SETTINGS_MODULE=esports.settings.local
SECRET_KEY=dev-only-change-me
DEBUG=True

# Local PostgreSQL (each developer runs their own; see docs/operations.md)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/esports

# HMAC salt for IP/UA hashing (docs/voting.md). Generate once per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNALS_SALT=dev-only-salt

# Cloudflare Turnstile (test keys below always pass; real keys in production)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Set False to skip the Turnstile widget entirely in local dev
TURNSTILE_ENABLED=False

# Shared secret for the internal scheduler endpoints (/internal/...)
INTERNAL_TOKEN=dev-only-internal-token

# Email (local: printed to console; production: organizer's SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Require TOTP 2FA for /staff/ (True in production — CLAUDE.md hard rule 4)
REQUIRE_2FA=False
